# === Canon adapter on the SBC ===
SBC_IP=192.168.1.70
INTERNAL_API_KEY=change-me-in-production
PORT=3001

# Live stream name published to MediaMTX (orchestrator streamPath)
STREAM_PATH=canon
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554/canon
MEDIAMTX_WEBRTC_URL=http://127.0.0.1:8889

# Observer / auto-timelapse (Open-Meteo, no weather API key)
OBSERVER_LAT=57.6261
OBSERVER_LON=39.8845
TIMEZONE_OFFSET=3
AUTO_TIMELAPSE=false
DAILY_REPORT_HOUR=8

# SMTP (adapter-side notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFICATION_EMAIL=

# SSH deploy
ORANGE_PI_ONE_IP_SSH=192.168.1.70
ORANGE_PI_ONE_USER_SSH=root
